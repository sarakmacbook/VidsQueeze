# ── required ────────────────────────────────────────────────────────────────
# Any Postgres works: Neon, Supabase, Vercel Postgres, RDS, or a local cluster.
# On Vercel, add this as an environment variable for *Production* and *Preview*.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── database ────────────────────────────────────────────────────────────────
# TLS override: require | verify-full | verify-ca | disable
# Leave unset by default. `pg` already honours a ?sslmode=require suffix on
# DATABASE_URL (which Neon, Supabase and Vercel Postgres all include), and `pg`
# has no "prefer" fallback — forcing TLS against a plain local cluster makes it
# fail with "The server does not support SSL connections".
# Set `require` only if your URL has no sslmode but the server still needs TLS.
# DATABASE_SSL_MODE=require
# Connections opened per instance. Serverless defaults to 3 so a burst of
# functions cannot exhaust the database's connection limit.
# PGPOOL_MAX=3

# ── encoder ─────────────────────────────────────────────────────────────────
# Absolute paths to binaries. Leave unset to use the ones bundled by
# ffmpeg-static / ffprobe-static, then anything on PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# Mirror of a custom ffmpeg build, used by ffmpeg-static at install time.
# FFMPEG_BINARIES_URL=https://example.internal/ffmpeg-builds

# ── scratch space ───────────────────────────────────────────────────────────
# Where sources, outputs and two-pass logs are written. Must be writable.
# On Vercel this has to stay under /tmp (the only writable path, 512 MB).
# VIDSQUEEZE_DIR=/tmp/vidsqueeze
# Refuse jobs that need more scratch space than this. Defaults to 384 MB on
# serverless hosts, unlimited elsewhere.
# VIDSQUEEZE_TMP_BUDGET_MB=384

# ── telegram ────────────────────────────────────────────────────────────────
# Point at a self-hosted Bot API server to lift the 20 MB download / 50 MB
# upload limits: https://github.com/tdlib/telegram-bot-api
# TELEGRAM_API_BASE=http://127.0.0.1:8081

# ── vercel ──────────────────────────────────────────────────────────────────
# Vercel creates this automatically when vercel.json declares a cron job, and
# sends it as `Authorization: Bearer <CRON_SECRET>` on every cron invocation.
# Set it yourself to lock /api/cron/drain down.
# CRON_SECRET=
# Largest upload the browser test bench accepts. Defaults to 4 MB on serverless
# (Vercel rejects any request body over 4.5 MB at the edge) and 300 MB on a
# long-lived host.
# MAX_UPLOAD_MB=300
# ffmpeg + ffprobe add ~143 MB to the function bundle. Vercel's standard limit
# is 250 MB unzipped; if you add more heavy dependencies and hit it, this opts
# into large functions (Fluid Compute).
# VERCEL_SUPPORT_LARGE_FUNCTIONS=1
